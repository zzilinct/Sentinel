{
  "manifest_version": 3,
  "name": "Sentinel Companion",
  "short_name": "Sentinel",
  "version": "1.1.0",
  "description": "Live scam, virus and malware masks on search results and in your inbox. Part of the Sentinel app. Works in Chrome, Edge, Brave and Firefox.",
  "homepage_url": "https://www.usesentinel.technology",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "alarms",
    "notifications",
    "contextMenus",
    "permissions"
  ],
  "host_permissions": [
    "https://www.usesentinel.technology/*",
    "http://127.0.0.1:47821/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.usesentinel.technology/connect*",
        "http://127.0.0.1:47821/connect*"
      ],
      "js": [
        "src/content/connect.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.google.com/search*",
        "*://*.google.co.uk/search*",
        "*://*.google.ca/search*",
        "*://*.google.com.au/search*",
        "*://*.google.de/search*",
        "*://*.google.fr/search*",
        "*://*.google.es/search*",
        "*://*.google.it/search*",
        "*://*.google.nl/search*",
        "*://*.google.co.in/search*",
        "*://*.google.com.br/search*",
        "*://*.google.co.jp/search*",
        "*://*.bing.com/search*",
        "*://duckduckgo.com/*",
        "*://html.duckduckgo.com/*",
        "*://search.yahoo.com/search*",
        "*://search.brave.com/search*",
        "*://*.ecosia.org/search*",
        "*://*.startpage.com/*",
        "*://*.mojeek.com/search*",
        "*://yandex.com/search*"
      ],
      "js": [
        "src/content/masks.js",
        "src/content/serp.js"
      ],
      "css": [
        "src/content/sentinel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": [
        "src/content/masks.js",
        "src/content/mail.js"
      ],
      "css": [
        "src/content/sentinel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/masks.js",
        "src/content/guard.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Sentinel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://www.usesentinel.technology/*",
      "http://127.0.0.1:47821/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
