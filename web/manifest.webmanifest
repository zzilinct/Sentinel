{
  "name": "Sentinel",
  "short_name": "Sentinel",
  "description": "Scam, virus and malware protection. See the danger before you click.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0a0b0d",
  "theme_color": "#0a0b0d",
  "categories": ["security", "utilities", "productivity"],
  "icons": [
    { "src": "/assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Scan a link", "url": "/app/scan", "icons": [{ "src": "/assets/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan a file", "url": "/app/threats", "icons": [{ "src": "/assets/img/icon-192.png", "sizes": "192x192" }] }
  ]
}
