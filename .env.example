# --- Sentinel server configuration ---------------------------------------
NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Public origin. Must match the domain users visit (used for cookies, CORS, OAuth).
PUBLIC_ORIGIN=https://www.sentinelscan.com

# Set when running behind a reverse proxy (Caddy/nginx) so client IPs are correct.
TRUST_PROXY=1

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Google sign-in (optional) -------------------------------------------
# Redirect URI to register: <PUBLIC_ORIGIN>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Threat intelligence ---------------------------------------------------
# Free public feeds (OpenPhish, URLhaus, Phishing.Database) refresh on this interval.
FEED_REFRESH_HOURS=6
# Optional: Google Safe Browsing v4 key for an extra known-threat source.
SAFE_BROWSING_API_KEY=

# --- Billing ------------------------------------------------------------------
# demo     = users can switch plans freely (development only)
# disabled = upgrade buttons explain that paid plans open soon
BILLING_MODE=disabled

DB_PATH=./data/sentinel.db
